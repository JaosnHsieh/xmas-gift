{
  "name": "xmas-gift",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node test/match.test.mjs",
    "build": "npx -y esbuild@0.25 src/index.js --bundle --format=esm --outfile=public/_worker.js",
    "dev": "npm run build && npx wrangler@4 pages dev",
    "deploy": "npm run build && npx wrangler@4 pages deploy",
    "db:local": "npx wrangler@4 d1 execute xmas-db --local --file=schema.sql"
  }
}
